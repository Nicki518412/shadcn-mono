# Prisma 相对路径按 schema 所在目录（packages/db/prisma/）解析，故需 ../../../ 回到仓库根再进入 packages/db/prisma
DATABASE_URL="file:../../../packages/db/prisma/dev.db"
JWT_SECRET="dev-secret-change-me"
# 认证提供方：local（JWT + 动态码）| clerk（Clerk 会话）
AUTH_PROVIDER="local"
# Clerk 模式（AUTH_PROVIDER=clerk）必需：https://dashboard.clerk.com → API Keys → Secret key
CLERK_SECRET_KEY=""
PORT=3001
